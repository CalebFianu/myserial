# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/myserial
DATABASE_USER=myserial
DATABASE_PASSWORD=myserial

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate a long random secret: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-chars

# ─── TMDB ─────────────────────────────────────────────────────────────────────
# Get your API key at https://www.themoviedb.org/settings/api
# Use the "API Read Access Token" (Bearer token) for v3 endpoints.
TMDB_API_KEY=your_tmdb_api_read_access_token

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080

# ─── Flutter API base URL (for local dev) ─────────────────────────────────────
# Android emulator uses 10.0.2.2 to reach host localhost
# iOS simulator uses localhost
API_BASE_URL=http://10.0.2.2:8080/api/v1
